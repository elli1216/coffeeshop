package com.local.cofeeshop.service;

import com.local.cofeeshop.dto.product.ProductRequest;
import com.local.cofeeshop.dto.product.ProductResponse;
import com.local.cofeeshop.exception.ResourceNotFoundException;
import com.local.cofeeshop.models.Category;
import com.local.cofeeshop.models.Product;
import com.local.cofeeshop.repository.ProductRepository;
import org.junit.jupiter.api.Test;
import org.junit.jupiter.api.extension.ExtendWith;
import org.mockito.InjectMocks;
import org.mockito.Mock;
import org.mockito.junit.jupiter.MockitoExtension;

import java.math.BigDecimal;
import java.util.Optional;

import static org.assertj.core.api.Assertions.*;
import static org.mockito.ArgumentMatchers.any;
import static org.mockito.Mockito.*;

@ExtendWith(MockitoExtension.class)
class ProductServiceTest {

    @Mock private ProductRepository productRepository;
    @Mock private CategoryService categoryService;

    @InjectMocks
    private ProductService productService;

    @Test
    void create_linksCategory_andDefaultsAvailableToTrue() {
        Category coffee = new Category();
        coffee.setId(1L);
        coffee.setName("Coffee");

        when(categoryService.getCategory(1L)).thenReturn(coffee);
        when(productRepository.save(any(Product.class))).thenAnswer(inv -> {
            Product p = inv.getArgument(0);
            p.setId(10L);
            return p;
        });

        ProductRequest request = new ProductRequest("Latte", "Espresso with milk", new BigDecimal("150.00"), null, 1L);
        ProductResponse result = productService.create(request);

        assertThat(result.id()).isEqualTo(10L);
        assertThat(result.available()).isTrue();
        assertThat(result.categoryName()).isEqualTo("Coffee");
    }

    @Test
    void create_throws_whenCategoryDoesNotExist() {
        when(categoryService.getCategory(99L))
                .thenThrow(new ResourceNotFoundException("Category not found: 99"));

        ProductRequest request = new ProductRequest("Latte", "Espresso with milk", new BigDecimal("150.00"), null, 99L);

        assertThatThrownBy(() -> productService.create(
                request))
                .isInstanceOf(ResourceNotFoundException.class);

        verify(productRepository, never()).save(any());
    }

    @Test
    void findById_throws_whenNotFound() {
        when(productRepository.findById(5L)).thenReturn(Optional.empty());

        assertThatThrownBy(() -> productService.findById(5L))
                .isInstanceOf(ResourceNotFoundException.class);
    }
}
